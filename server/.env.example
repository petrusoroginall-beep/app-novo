# Chave de API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Porta em que o servidor backend vai rodar
PORT=3001

# Modelo usado para gerar as falas do NPC e avaliar o progresso.
# Opcional - se não definir, usa claude-opus-5.
# Para respostas mais rápidas/baratas durante testes, experimente claude-sonnet-5.
ANTHROPIC_MODEL=claude-opus-5
